{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@playwright/test"],
    "noEmit": true,
    "strict": true,
    // See tsconfig.app.json.
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["e2e"]
}
