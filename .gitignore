# Dependencies
node_modules/

# Build output
dist/
dev-dist/

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/

# Editor / OS
.DS_Store
*.local
.vscode/
.idea/

# Env / secrets — never commit credentials
.env
.env.*
!.env.example
.wrangler/
.dev.vars

# Logs
*.log
npm-debug.log*

# Local QA output (screenshots + measurements)
audit-out/
# Responsive/overflow audit shots. Regenerated by `scripts/overflow-audit.mjs`
# on every run, ~14 MB of PNGs that churn wholesale each time. The audit's
# deliverable is its measured table; the shots are the working evidence behind
# it and stay local, like everything else under this heading.
docs/audit/shots/
*.tsbuildinfo

# Motion Wave native build output
motionwave/build/

# The panel harness's build, and the worklet copy build.sh drops beside it.
# Both are outputs of `npm run build:panel` / `npm run build:wasm`; a committed
# copy is a second binary that can disagree with the one the boundary test
# verified.
motionwave/ui/dev/dist/
motionwave/ui/dev/public/motionwave.worklet.js

# `motionwave/wasm/prebuilt/` is deliberately NOT ignored: it is the core the
# app's production build ships, and that build has to run where there is no C++
# toolchain. `npm run wasm:check` proves it still matches its source, and CI has
# the toolchain and runs it.
#
# Copies of the Motion Wave runtime, dropped by
# `scripts/sync-motionwave-assets.mjs` from `motionwave/wasm/dist/` and
# `motionwave/ui/worklet/`. The sources are tracked; these are build output, and
# a tracked copy would be a second version of a file that must have one.
public/worklets/motionwave.worklet.js
public/worklets/unit_worklet.js
motionwave/ui/dev/public/motionwave.worklet.js
motionwave/ui/dev/public/unit_worklet.js
